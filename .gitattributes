# Normalize text files to LF. Specific overrides below take precedence.
* text=auto eol=lf

# Windows batch files require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Common binaries.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
*.zst binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.wasm binary

# Only the large constraint systems belong in LFS. Runtime proving keys stay in
# ordinary Git so builds and tests never depend on LFS bandwidth.
tools/gnark/artifacts/note_seizure/note_seizure.sr1cs filter=lfs diff=lfs merge=lfs -text
